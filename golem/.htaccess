RewriteEngine On

########################################################################
# STABLE ONTOLOGY IRI
# https://w3id.org/golem/ontology
########################################################################

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle [NC]
RewriteRule ^ontology$ https://ontology.golemlab.eu/current/golem.ttl [R=303,L]

# OWL
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^ontology$ https://ontology.golemlab.eu/current/golem.owl [R=303,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^ontology$ https://ontology.golemlab.eu/current/golem.jsonld [R=303,L]

# HTML
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^ontology$ https://ontology.golemlab.eu/current/golem.html [R=303,L]

# Default representation: HTML
RewriteRule ^ontology$ https://ontology.golemlab.eu/current/golem.html [R=303,L]


########################################################################
# VERSION IRI 2.0
# https://w3id.org/golem/ontology/v2.0
########################################################################

# Turtle
RewriteCond %{HTTP_ACCEPT} text/turtle [NC,OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle [NC]
RewriteRule ^ontology/v2\.0$ https://ontology.golemlab.eu/releases/v2-0/golem_v2-0.ttl [R=303,L]

# OWL
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^ontology/v2\.0$ https://ontology.golemlab.eu/releases/v2-0/golem_v2-0.owl [R=303,L]

# JSON-LD
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^ontology/v2\.0$ https://ontology.golemlab.eu/releases/v2-0/golem_v2-0.jsonld [R=303,L]

# HTML
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^ontology/v2\.0$ https://ontology.golemlab.eu/releases/v2-0/golem_v2-0.html [R=303,L]

# Default representation: HTML
RewriteRule ^ontology/v2\.0$ https://ontology.golemlab.eu/releases/v2-0/golem_v2-0.html [R=303,L]